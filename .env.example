# Template for your .env file.
#
# 1. Copy this file and name the copy ".env"  (cp .env.example .env)
# 2. Paste in your OpenSky API client credentials (see README.md for how to get them).
#
# .env is listed in .gitignore, so your real secrets never end up on GitHub.
# Leave both values empty to use anonymous access (only 400 API credits per day).

OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional: the port the web server listens on (default 3000).
# Change it if another program is already using port 3000.
# PORT=3000
